<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="LlanoSetup">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="13" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ARPNOMODIFY" Value="1" />
      <Property Id="OpenAfterSetup" Value="1" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="SetupOptions" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="Heading" Type="Text" X="15" Y="13" Width="340" Height="24" Transparent="yes"
                 Text="{\WixUI_Font_Bigger}Install Llano Ultra Control" />
        <Control Id="Introduction" Type="Text" X="18" Y="60" Width="330" Height="34"
                 Text="Setup adds Llano Ultra Control to the Start menu. Close the app from the notification area if you are updating an existing installation." />
        <Control Id="DesktopShortcut" Type="CheckBox" X="18" Y="106" Width="330" Height="18" Property="ADDDESKTOPSHORTCUT"
                 CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
        <Control Id="Permissions" Type="Text" X="18" Y="147" Width="330" Height="46"
                 Text="Setup asks for administrator approval. To access more CPU readings and FPS, open Settings in the app and select Enable sensor and FPS access." />
        <Control Id="ButtonDivider" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" X="220" Y="243" Width="72" Height="17" Default="yes" ElevationShield="yes" Text="&amp;Install">
          <Publish Property="ADDDESKTOPSHORTCUT" Value="0" Order="1" Condition="NOT ADDDESKTOPSHORTCUT" />
          <Publish Property="LlanoInteractiveInstall" Value="1" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="RemoveConfirm" Width="370" Height="270" Title="Uninstall [ProductName]">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="Heading" Type="Text" X="15" Y="13" Width="340" Height="24" Transparent="yes"
                 Text="{\WixUI_Font_Bigger}Uninstall Llano Ultra Control" />
        <Control Id="Contents" Type="Text" X="18" Y="60" Width="330" Height="50"
                 Text="Uninstall removes the app, its shortcuts, its sign-in entries, and saved profiles and preferences for your Windows account." />
        <Control Id="Tray" Type="Text" X="18" Y="118" Width="330" Height="48"
                 Text="If the app is running, right-click its icon in the notification area and select Exit. Then select Uninstall." />
        <Control Id="ButtonDivider" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="142" Y="243" Width="72" Height="17" Text="&amp;Back"
                 Hidden="yes" ShowCondition="NOT (REMOVE ~= &quot;ALL&quot;)">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="220" Y="243" Width="72" Height="17" ElevationShield="yes" Text="&amp;Uninstall">
          <Publish Property="REMOVE" Value="ALL" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="SetupComplete" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="Heading" Type="Text" X="15" Y="13" Width="340" Height="24" Transparent="yes"
                 Text="{\WixUI_Font_Bigger}Setup complete" HideCondition="REMOVE ~= &quot;ALL&quot;" />
        <Control Id="RemovedHeading" Type="Text" X="15" Y="13" Width="340" Height="24" Transparent="yes"
                 Text="{\WixUI_Font_Bigger}Llano Ultra Control uninstalled" Hidden="yes" ShowCondition="REMOVE ~= &quot;ALL&quot;" />
        <Control Id="RemovalComplete" Type="Text" X="18" Y="65" Width="330" Height="50"
                 Text="Select Finish to close setup." Hidden="yes" ShowCondition="REMOVE ~= &quot;ALL&quot;" />
        <Control Id="OpenApp" Type="CheckBox" X="18" Y="76" Width="330" Height="18" Property="OpenAfterSetup"
                 CheckBoxValue="1" Text="&amp;Open Llano Ultra Control" Hidden="yes" ShowCondition="LlanoInteractiveInstall = 1" />
        <Control Id="ButtonDivider" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Property="WixShellExecTarget" Value="[INSTALLFOLDER]LlanoUltraControl.exe" Order="1"
                   Condition="LlanoInteractiveInstall = 1 AND OpenAfterSetup = 1 AND NOT (MsiRunningElevated = 1)" />
          <Publish Property="WixUnelevatedShellExecTarget" Value="[INSTALLFOLDER]LlanoUltraControl.exe" Order="2"
                   Condition="LlanoInteractiveInstall = 1 AND OpenAfterSetup = 1 AND MsiRunningElevated = 1" />
          <Publish Event="DoAction" Value="OpenLlano" Order="3"
                   Condition="LlanoInteractiveInstall = 1 AND OpenAfterSetup = 1 AND NOT (MsiRunningElevated = 1)" />
          <Publish Event="DoAction" Value="OpenLlanoUnelevated" Order="4"
                   Condition="LlanoInteractiveInstall = 1 AND OpenAfterSetup = 1 AND MsiRunningElevated = 1" />
          <Publish Event="EndDialog" Value="Return" Order="5" />
        </Control>
      </Dialog>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="RemoveConfirm" Order="2" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <InstallUISequence>
        <Show Dialog="SetupOptions" After="LaunchConditions" Condition="NOT Installed AND NOT RESUME" />
        <Show Dialog="RemoveConfirm" After="SetupOptions" Condition="Installed AND REMOVE ~= &quot;ALL&quot; AND NOT RESUME" />
        <Show Dialog="override MaintenanceWelcomeDlg" Before="ProgressDlg"
              Condition="Installed AND NOT (REMOVE ~= &quot;ALL&quot;) AND NOT RESUME AND NOT Preselected AND NOT PATCH" />
        <Show Dialog="SetupComplete" OnExit="success" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="SetupComplete" OnExit="success" />
      </AdminUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
    <CustomAction Id="OpenLlano" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="OpenLlanoUnelevated" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixUnelevatedShellExec"
                  Execute="immediate" Return="ignore" />
  </Fragment>
</Wix>
