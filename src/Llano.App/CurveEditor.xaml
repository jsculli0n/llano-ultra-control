<UserControl x:Class="Llano.App.CurveEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <DataGrid x:Name="Points" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
              CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
              IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SelectionChanged"
              Background="{DynamicResource Panel}" RowBackground="{DynamicResource Panel}" AlternatingRowBackground="{DynamicResource Input}"
              Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" RowHeight="37" MaxHeight="204">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Temperature (°C)" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBox Text="{Binding Celsius, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Curve point temperature in Celsius" Padding="6,4"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Speed (RPM)" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBox Text="{Binding Rpm, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Curve point RPM" Padding="6,4"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Margin="0,8,0,0">
      <Button x:Name="AddButton" Content="Add point" Click="AddPoint" Padding="8,5"/>
      <Button x:Name="RemoveButton" Content="Remove selected" Click="RemovePoint" Padding="8,5" IsEnabled="False"/>
    </WrapPanel>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Warning}" FontSize="12" Visibility="Collapsed"
               AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
