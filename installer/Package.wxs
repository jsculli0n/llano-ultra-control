<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Llano Ultra Control" Manufacturer="Llano Ultra Control contributors" Version="$(var.ProductVersion)"
           UpgradeCode="2148F8B8-9775-483C-8D49-418EFB61ADE9" Scope="perMachine">
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of Llano Ultra Control is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="LlanoUltraControl.exe" SourceFile="$(var.PublishDir)\LlanoUltraControl.exe" />
    <Property Id="ARPPRODUCTICON" Value="LlanoUltraControl.exe" />
    <!-- Let users close the tray app themselves if its files are in use. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
    <Property Id="ADDDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="LLANO_EXISTING_DESKTOP_SHORTCUT" Secure="yes">
      <RegistrySearch Id="DesktopShortcutPreviouslySelected" Root="HKLM" Key="SOFTWARE\LlanoUltraControl\Installer"
                      Name="DesktopShortcut" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="ADDDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="both"
                 Condition="NOT ADDDESKTOPSHORTCUT AND LLANO_EXISTING_DESKTOP_SHORTCUT = 1" />
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="WindowsBuildNumber" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 22000)"
            Message="Llano Ultra Control requires Windows 11 x64." />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Llano Ultra Control">
        <Component Id="MainExecutable" Guid="*">
          <File Id="AppExe" Source="$(var.PublishDir)\LlanoUltraControl.exe" KeyPath="yes">
            <Shortcut Id="StartMenuLink" Directory="ProgramMenuFolder" Name="Llano Ultra Control"
                      WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="LlanoUltraControl.exe" IconIndex="0" />
          </File>
        </Component>
        <Component Id="DesktopShortcut" Guid="*" Condition="ADDDESKTOPSHORTCUT = 1">
          <Shortcut Id="DesktopLink" Directory="DesktopFolder" Name="Llano Ultra Control" Target="[INSTALLFOLDER]LlanoUltraControl.exe"
                    WorkingDirectory="INSTALLFOLDER" Icon="LlanoUltraControl.exe" IconIndex="0" />
          <RegistryValue Root="HKMU" Key="SOFTWARE\LlanoUltraControl\Installer" Name="DesktopShortcut"
                         Type="string" Value="1" KeyPath="yes" />
        </Component>
        <Files Include="$(var.PublishDir)\**">
          <Exclude Files="$(var.PublishDir)\LlanoUltraControl.exe" />
        </Files>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <UIRef Id="LlanoSetup" />
    <Binary Id="RemovePreferencesExe" SourceFile="$(var.RemovePreferences.TargetPath)" />
    <CustomAction Id="RemovePreferences" BinaryRef="RemovePreferencesExe" ExeCommand=""
                  Execute="commit" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RemovePreferencesWithoutRollback" BinaryRef="RemovePreferencesExe" ExeCommand=""
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RemoveStartupTasks" FileRef="AppExe" ExeCommand="--remove-startup-tasks"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveStartupTasks" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemovePreferences" After="RemoveFiles"
              Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT RollbackDisabled" />
      <Custom Action="RemovePreferencesWithoutRollback" After="RemovePreferences"
              Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND RollbackDisabled" />
    </InstallExecuteSequence>
  </Package>
</Wix>
